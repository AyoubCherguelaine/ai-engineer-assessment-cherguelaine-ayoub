# LiteLLM routes this default model to Cerebras.
CEREBRAS_API_KEY=your_cerebras_key
CEREBRAS_MODEL=gpt-oss-120b
# Optional fully-qualified LiteLLM override.
LITELLM_MODEL=cerebras/gpt-oss-120b

# Create a free key at https://superheroapi.com/ and use only the token here.
SUPERHERO_API_TOKEN=your_superhero_api_token

# Optional HTTP timeout, in seconds.
HTTP_TIMEOUT_SECONDS=15

# Superhero API is occasionally slow; this has its own safer timeout.
SUPERHERO_TIMEOUT_SECONDS=30
